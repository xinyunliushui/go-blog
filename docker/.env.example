# 复制为 .env 后按需修改
COMPOSE_PROJECT_NAME=go-blog-test

# ── 国内镜像源 ─────────────────────────────────────────────
# DOCKER_MIRROR：compose 里第三方镜像前缀（mysql/rabbitmq/clickhouse/curl 等）
# DOCKER_REGISTRY：Dockerfile 基础镜像前缀（golang/alpine/elasticsearch 等，需带 /library）
#
# 任选其一，不稳定时换另一个即可：
#   docker.m.daocloud.io          （推荐，较稳定）
#   docker.1ms.run
#   docker.xuanyuan.me
#   docker.1panel.live
#
# 修改后执行：docker compose pull && docker compose up -d --build
DOCKER_MIRROR=docker.m.daocloud.io
DOCKER_REGISTRY=docker.m.daocloud.io/library

# 第三方镜像版本（升级时只改此处）
MYSQL_IMAGE_TAG=8.0
RABBITMQ_IMAGE_TAG=3.13-management-alpine
CURL_IMAGE_TAG=8.12.1
CLICKHOUSE_IMAGE_TAG=24.8
ES_VERSION=8.19.5
APP_IMAGE_TAG=test

# Go / Alpine 构建源
GOPROXY=https://goproxy.cn,direct
GOSUMDB=sum.golang.google.cn
APK_MIRROR=mirrors.aliyun.com

# ── MySQL ──────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=blogY1Jo)%
MYSQL_DATABASE=go_blog
MYSQL_PORT=3306

# ── RabbitMQ ───────────────────────────────────────────────
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=123456
RABBITMQ_VHOST=go_blog
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# ── Elasticsearch ──────────────────────────────────────────
ES_PORT=9200
ES_MEM_LIMIT=1g
ES_JAVA_OPTS=-Xms512m -Xmx512m
ELASTICSEARCH_ADDRESS=http://elasticsearch:9200
ELASTICSEARCH_USERNAME=admin
ELASTICSEARCH_PASSWORD=123456
ELASTICSEARCH_INDEX_NAME=go_blog

# ── ClickHouse ─────────────────────────────────────────────
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_USER=admin
CLICKHOUSE_PASSWORD=123456
CLICKHOUSE_DB=go_blog

# ── go-blog 应用 ───────────────────────────────────────────
APP_ENV=test
APP_PORT=8080
